# 네이버 개발자센터(https://developers.naver.com/apps) 에서 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 카카오 개발자센터(https://developers.kakao.com) 에서 발급
KAKAO_REST_API_KEY=
# scripts/get_kakao_token.py 로 최초 1회 발급
KAKAO_REFRESH_TOKEN=

# ---- 소부장 뉴스레터 (python -m src.newsletter) ----
# Gmail 주소 + 앱 비밀번호(https://myaccount.google.com/apppasswords)
SMTP_USER=
SMTP_PASSWORD=
# 받는 사람 (쉼표로 여러 명 가능, 비우면 devla@naver.com)
RECIPIENT_EMAIL=
# OpenDART 인증키 (https://opendart.fss.or.kr) - 재무 열
OPENDART_KEY=
# Gemini API 키 (선택) - AI 추정 코멘트
GEMINI_KEY=
